// Analytix AI Business Transformation OS — Data Model
//
// PHASES 1–7 — ALL ACTIVE. 25 models, grouped below by the phase that introduced them:
// Foundation (org structure, auth/RBAC, project setup, knowledge sources, audit log),
// AI Interviews, Process Digital Twin / SOP Library / Knowledge Base, AI Opportunities &
// AI Projects, Agents / ROI / Governance, and Training / Continuous Improvement / Impact
// Measurement / Integrations. Full reference: TECHNICAL_DOCUMENT.md §4.
//
// The commented block below the "FUTURE SCHEMA" divider at the end of this file is NOT built —
// it documents fuller spec-model shapes (process-step normalization, SOP/knowledge versioning,
// formal Risk / Approval entities, separate metric tables) so later work extends this schema
// toward them instead of inventing a parallel one.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Postgres (Neon). DATABASE_URL is the connection the app uses; DIRECT_URL is the
  // non-pooled connection `prisma migrate` uses. Both are in .env. See TECHNICAL_DOCUMENT.md §8.
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// PHASE 1 — Foundation
// ---------------------------------------------------------------------------

model Organization {
  id        String     @id @default(cuid())
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  countries Country[]
  users     User[]
  projects  AiTransformationProject[]
}

model Country {
  id             String       @id @default(cuid())
  name           String
  isoCode        String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  divisions      Division[]
  createdAt      DateTime     @default(now())

  @@unique([organizationId, name])
}

model Division {
  id          String       @id @default(cuid())
  name        String
  countryId   String
  country     Country      @relation(fields: [countryId], references: [id], onDelete: Cascade)
  departments Department[]
  createdAt   DateTime     @default(now())

  @@unique([countryId, name])
}

model Department {
  id          String   @id @default(cuid())
  name        String
  serviceArea String? // one of Analytix's seeded service categories, free text for now
  divisionId  String
  division    Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  departmentHeadId String?
  departmentHead   User?   @relation("DepartmentHead", fields: [departmentHeadId], references: [id])

  projects AiTransformationProject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([divisionId, name])
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String // Role (see src/lib/enums.ts) - SQLite has no native enum support
  jobTitle     String?
  isDemoUser   Boolean  @default(false)
  active       Boolean  @default(true)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  headOfDepartments     Department[]               @relation("DepartmentHead")
  ownedProjects         AiTransformationProject[]   @relation("ProcessOwner")
  uploadedKnowledge     KnowledgeSource[]
  auditLogs             AuditLog[]
  createdProcesses      Process[]
  interviewsConducted   Interview[]
  inviteLinksAsEmployee InterviewInviteLink[]        @relation("InviteLinkEmployee")
  inviteLinksCreated    InterviewInviteLink[]        @relation("InviteLinkCreator")
  sopsGenerated         Sop[]
  aiProjectsGenerated   AiProject[]
  agentsPublished       Agent[]
  roiEstimatesCalculated RoiEstimate[]
  governanceDecisions   GovernanceStage[]
  trainingModulesGenerated TrainingModule[]
  changeRequestsRaised     ChangeRequest[]      @relation("ChangeRequestRaisedBy")
  changeRequestsResolved   ChangeRequest[]      @relation("ChangeRequestResolvedBy")
  impactMeasurementsRecorded ImpactMeasurement[]
  integrationsConfigured   Integration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// The Project Setup entity from spec section 4. In Phase 1 this *is* the "AI transformation
// project" record; Phase 5's richer AiProject (business case, ROI, MVP, governance state) will
// extend/reference this same row rather than duplicating it.
model AiTransformationProject {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      String        @default("SETUP") // ProjectStatus (see src/lib/enums.ts)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  processOwnerId String?
  processOwner   User?   @relation("ProcessOwner", fields: [processOwnerId], references: [id])

  // --- Section 4 setup fields ---
  service                String? // Analytix service line
  businessObjective      String?
  aiProjectIdea          String?
  interviewObjective     String?
  inScopeActivities      String? // free text list, one per line
  outOfScopeActivities   String? // free text list, one per line
  currentSystems         String? // e.g. "Odoo, Excel, Government Portal, WhatsApp"
  existingSopSummary     String?
  knownBackendFacts      String?
  mandatoryChecks        String?
  mandatoryApprovals     String?
  currentTemplates       String?
  currentForms           String?
  currentChecklists      String?
  policiesReferenced     String?
  regulatoryReferences   String?
  existingPainPoints     String?
  currentVolume          String? // e.g. "20-25 cases / month"
  currentManpower        String? // e.g. "3 case officers, 1 team lead"
  existingAiTools        String?

  knowledgeSources KnowledgeSource[]
  processes        Process[]
  inviteLinks      InterviewInviteLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model KnowledgeSource {
  id        String            @id @default(cuid())
  projectId String
  project   AiTransformationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  fileName     String
  mimeType     String
  sizeBytes    Int
  storagePath  String // path relative to KNOWLEDGE_STORAGE_DIR
  trustLevel   String            @default("EMPLOYEE_STATEMENT") // SourceTrustLevel (see src/lib/enums.ts)
  extractedText String? // populated by a later-phase extraction/RAG pipeline; null in Phase 1

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String // e.g. "department.created", "project.created", "knowledge_source.uploaded"
  entityType String
  entityId   String
  metadata   String? // JSON-encoded string (SQLite has no native JSON type)
  createdAt  DateTime @default(now())
}

// ---------------------------------------------------------------------------
// PHASE 2 — AI Interviews
// ---------------------------------------------------------------------------
//
// A pragmatic Phase 2 shape rather than the full spec-section-7/9/12 normalized model
// (InterviewQuestion / InterviewAnswer / InterviewFact / ProcessStep with FactStatus): the
// deterministic engine's full bookkeeping state (src/lib/interview-engine.ts's InterviewState)
// is round-tripped as JSON in Interview.stateJson between turns, while the parts other Phase 3+
// modules will actually need to query — the transcript, the extracted walkthrough steps, and the
// AI Observation confirmations — get their own normalized tables below. When Phase 3 builds the
// process digital twin it can migrate stateJson's contents into the fuller spec model without
// changing how interviews are conducted.

model Process {
  id          String   @id @default(cuid())
  projectId   String
  project     AiTransformationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String? // filled in once the employee names it (engine state's qProcessName answer)
  department  String?
  status      String   @default("IN_PROGRESS") // IN_PROGRESS | COMPLETE (an Interview reaching status=COMPLETED marks this)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  interviews  Interview[]
  sop            Sop?
  knowledgeItems KnowledgeItem[]
  aiOpportunities AiOpportunity[]
  joinInviteLinks InterviewInviteLink[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Interview {
  id           String    @id @default(cuid())
  processId    String
  process      Process   @relation(fields: [processId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     User      @relation(fields: [employeeId], references: [id])
  language     String    @default("en") // en | hi | ar | zh | ml
  status       String    @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED | ABANDONED
  stateJson    String // JSON-serialized InterviewState (src/lib/interview-engine.ts) — see note above
  completeness Int       @default(0)
  // Set only when this interview was started from a shareable invite link (src/app/interview/[token])
  // rather than by the employee signing in — see InterviewInviteLink below. Guest server actions
  // (submitGuestInterviewAnswer etc.) only ever operate on interviews where this is non-null, so a
  // normal authenticated employee's interview can never be reached without a session.
  inviteLinkId String?
  inviteLink   InterviewInviteLink? @relation(fields: [inviteLinkId], references: [id])
  startedAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  completedAt  DateTime?

  messages     InterviewMessage[]
  steps        InterviewStepRecord[]
  observations InterviewObservation[]
}

// A shareable link generated for one specific project + pre-selected staff member, so that
// person can conduct their AI interview by following the link — no Analytix OS login required.
// The link generator picks Department -> Project -> Staff Name (all existing records); opening
// the link starts (or resumes) that staff member's interview immediately.
model InterviewInviteLink {
  id          String   @id @default(cuid())
  token       String   @unique @default(cuid())
  projectId   String
  project     AiTransformationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    User     @relation("InviteLinkEmployee", fields: [employeeId], references: [id])
  language    String   @default("en")
  active      Boolean  @default(true)
  createdById String
  createdBy   User     @relation("InviteLinkCreator", fields: [createdById], references: [id])
  // Set when the link was generated to gather ANOTHER perspective on a process someone already
  // described (mirrors joinProcessId on startInterview), instead of always starting a fresh one.
  // SetNull rather than Cascade: revoking/deleting the joined Process shouldn't take the link with it.
  joinProcessId String?
  joinProcess   Process? @relation(fields: [joinProcessId], references: [id], onDelete: SetNull)
  interviews  Interview[]
  createdAt   DateTime @default(now())
}

model InterviewMessage {
  id          String    @id @default(cuid())
  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  sender      String // AI | EMPLOYEE
  questionKey String? // the engine's question key this message asked or answered, e.g. "qFirstStep"
  text        String
  createdAt   DateTime  @default(now())
}

// One row per step the employee described while walking through a real case
// (engine state's `steps` array — see handleWalkthroughStep in interview-engine.ts).
model InterviewStepRecord {
  id          String    @id @default(cuid())
  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  stepIndex   Int
  text        String
  owner       String?
  systems     String? // comma-separated system names mentioned in this step
  createdAt   DateTime  @default(now())
}

// One row per AI Observation card shown and resolved (Yes / Partly / No) — never silently
// assumed; see the master prompt's "AI Observation confirmation" requirement.
model InterviewObservation {
  id          String    @id @default(cuid())
  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  key         String // duplicateEntry | docDependency | knowledgeRisk | manualFollowUp | authorityCheck | bottleneckGeneral
  category    String // OBSERVATION | BOTTLENECK | KNOWLEDGE_RISK
  text        String
  status      String    @default("PENDING") // PENDING | CONFIRMED | PARTLY | REJECTED
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
}

// ---------------------------------------------------------------------------
// PHASE 3 — Process Digital Twin, SOP Library & Knowledge Base
// ---------------------------------------------------------------------------
//
// Digital Twin / Process Discovery / Process Maps / Bottlenecks are pure derived read views over
// the Phase 2 tables above (Process, Interview.stateJson, InterviewStepRecord,
// InterviewObservation) — no schema needed for those. SOP Library and Knowledge Base persist
// their own deterministically-generated content below.

model Sop {
  id                String   @id @default(cuid())
  processId         String   @unique
  process           Process  @relation(fields: [processId], references: [id], onDelete: Cascade)
  title             String
  contentMd         String // deterministic markdown template generated from captured facts (src/lib/sop-template.ts)
  status            String   @default("DRAFT") // DRAFT | PUBLISHED
  sourceInterviewId String // not a relation: the SOP should outlive the interview it was generated from
  generatedById     String
  generatedBy       User     @relation(fields: [generatedById], references: [id])
  generatedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt

  trainingModule TrainingModule?
  changeRequests ChangeRequest[]
}

// One row per distinct knowledge/template statement an employee mentioned during an interview
// (engine state's `knowledge[]` / `templates[]` arrays) — populated automatically when an
// interview completes (see syncKnowledgeItemsOnCompletion in src/lib/actions/interviews.ts).
model KnowledgeItem {
  id                String   @id @default(cuid())
  processId         String
  process           Process  @relation(fields: [processId], references: [id], onDelete: Cascade)
  category          String // KNOWLEDGE | TEMPLATE
  text              String
  trustLevel        String   @default("EMPLOYEE_STATEMENT") // SourceTrustLevel (see src/lib/enums.ts)
  sourceInterviewId String // not a relation: the item should outlive the interview it was captured from
  createdAt         DateTime @default(now())

  @@unique([processId, category, text])
}

// ---------------------------------------------------------------------------
// PHASE 4 — AI Opportunities & AI Projects
// ---------------------------------------------------------------------------
//
// AiOpportunity rows are populated automatically when an interview completes, one per confirmed
// (CONFIRMED or PARTLY) AI observation the engine raised — see syncAiOpportunitiesOnCompletion in
// src/lib/actions/interviews.ts. impact/effort are deterministic LOW|MEDIUM|HIGH bands derived
// from captured facts (src/lib/ai-opportunity-rules.ts), never a fabricated numeric score.
// AiProject is the deliberate synthesis step — a reviewer generates a deterministic business-case
// markdown document from one opportunity (src/lib/ai-project-template.ts), mirroring the SOP
// Library's generate/regenerate/publish pattern from Phase 3.

model AiOpportunity {
  id                String   @id @default(cuid())
  processId         String
  process           Process  @relation(fields: [processId], references: [id], onDelete: Cascade)
  key               String // duplicateEntry | docDependency | knowledgeRisk | manualFollowUp | authorityCheck | bottleneckGeneral
  category          String // OBSERVATION | BOTTLENECK | KNOWLEDGE_RISK (mirrors InterviewObservation.category)
  title             String
  description       String // the confirmed AI observation's own text — never fabricated
  recommendation    String // deterministic suggested approach (see OPPORTUNITY_CONTENT)
  impact            String // LOW | MEDIUM | HIGH
  effort            String // LOW | MEDIUM | HIGH
  status            String   @default("IDENTIFIED") // IDENTIFIED | DISMISSED
  sourceInterviewId String // not a relation: the opportunity should outlive the interview it came from
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  aiProject   AiProject?
  roiEstimate RoiEstimate?

  @@unique([processId, key])
}

model AiProject {
  id            String        @id @default(cuid())
  opportunityId String        @unique
  opportunity   AiOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  title         String
  contentMd     String // deterministic markdown business case (src/lib/ai-project-template.ts)
  status        String        @default("DRAFT") // DRAFT | PROPOSED
  generatedById String
  generatedBy   User          @relation(fields: [generatedById], references: [id])
  generatedAt   DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  agent Agent?

  // Phase 6: sequential governance sign-off, process owner through to production.
  governanceStatus String            @default("NOT_STARTED") // NOT_STARTED | IN_REVIEW | APPROVED | REJECTED
  productionAt     DateTime?
  governanceStages GovernanceStage[]
}


// Phase 5: a published, reusable AI agent — the productized form of an AI Project once a
// reviewer marks it PROPOSED and decides it's worth cataloguing for reuse elsewhere. `key` mirrors
// AiOpportunity.key so the Agent Library page can surface "reuse candidates": other IDENTIFIED
// opportunities of the same kind across the organization that this same agent could address.
model Agent {
  id              String    @id @default(cuid())
  key             String // matches AiOpportunity.key (duplicateEntry | docDependency | ...)
  category        String // OBSERVATION | BOTTLENECK | KNOWLEDGE_RISK (mirrors AiOpportunity.category)
  name            String
  description     String // the source AI Project's proposed approach, carried over verbatim
  status          String    @default("DRAFT") // DRAFT | ACTIVE | RETIRED
  sourceProjectId String    @unique
  sourceProject   AiProject @relation(fields: [sourceProjectId], references: [id], onDelete: Cascade)
  publishedById   String
  publishedBy     User      @relation(fields: [publishedById], references: [id])
  publishedAt     DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  impactMeasurements ImpactMeasurement[]
}

// Phase 5: a deterministic, formula-based savings estimate for one AI Opportunity — not a real
// financial model, just a transparent calculation from reviewer-supplied inputs (case volume,
// cost per hour) and a documented per-case time-saved heuristic keyed off the opportunity's impact
// band (src/lib/roi-rules.ts). `assumptions` spells out exactly how the numbers were derived so a
// reviewer never mistakes this for audited financial analysis.
model RoiEstimate {
  id                     String        @id @default(cuid())
  opportunityId          String        @unique
  opportunity            AiOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  monthlyVolume          Int
  minutesSavedPerCase    Int
  costPerHour            Float
  hoursSavedPerMonth     Float
  monthlySavingsEstimate Float
  annualSavingsEstimate  Float
  assumptions            String
  calculatedById         String
  calculatedBy           User          @relation(fields: [calculatedById], references: [id])
  calculatedAt           DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
}


// Phase 6: one fixed sign-off step in an AiProject's governance chain (process owner ->
// department head -> legal/compliance -> information security -> AI transformation committee ->
// management/CEO -> production). Stages are created together (stageOrder 1..6) when governance
// review starts, and can only be decided in order -- see governance-rules.ts's currentStage() --
// so "3/6 approved" always means stages 1-3, never an out-of-sequence subset.
model GovernanceStage {
  id          String    @id @default(cuid())
  aiProjectId String
  aiProject   AiProject @relation(fields: [aiProjectId], references: [id], onDelete: Cascade)
  stageOrder  Int // 1..6, fixed sequence — see governance-rules.ts's STAGE_SEQUENCE
  role        String // the Role required to decide this stage
  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED
  decidedById String?
  decidedBy   User?     @relation(fields: [decidedById], references: [id])
  decidedAt   DateTime?
  comment     String?
  createdAt   DateTime  @default(now())

  @@unique([aiProjectId, stageOrder])
}


// Phase 7: a deterministic training module generated from a published SOP -- turns its
// step-by-step procedure and known pain points into a learning outline. Never a real LLM call,
// same philosophy as sop-template.ts / ai-project-template.ts.
model TrainingModule {
  id            String   @id @default(cuid())
  sopId         String   @unique
  sop           Sop      @relation(fields: [sopId], references: [id], onDelete: Cascade)
  title         String
  contentMd     String
  status        String   @default("DRAFT") // DRAFT | PUBLISHED
  generatedById String
  generatedBy   User     @relation(fields: [generatedById], references: [id])
  generatedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Phase 7: a flagged review or change request against a published SOP -- continuous improvement.
model ChangeRequest {
  id             String    @id @default(cuid())
  sopId          String
  sop            Sop       @relation(fields: [sopId], references: [id], onDelete: Cascade)
  summary        String
  status         String    @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED
  raisedById     String
  raisedBy       User      @relation("ChangeRequestRaisedBy", fields: [raisedById], references: [id])
  resolvedById   String?
  resolvedBy     User?     @relation("ChangeRequestResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// Phase 7: one 30/60/90-day before-vs-after checkpoint against an Agent's baseline RoiEstimate.
// actual* fields are reviewer-entered (this app has no live usage telemetry to pull from) --
// recordedAt null means the checkpoint hasn't been measured yet, even if its due date has passed.
model ImpactMeasurement {
  id                  String    @id @default(cuid())
  agentId             String
  agent               Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  checkpointDays      Int // 30 | 60 | 90
  actualMonthlyVolume Int?
  actualHoursSaved    Float?
  actualSavings       Float?
  note                String?
  recordedById        String?
  recordedBy          User?     @relation(fields: [recordedById], references: [id])
  recordedAt          DateTime?
  createdAt           DateTime  @default(now())

  @@unique([agentId, checkpointDays])
}

// Phase 7: a connector registry entry -- configuration metadata only. This app has no real
// credentials for Odoo / Analytix360 / email / WhatsApp, so this deliberately never claims a live
// sync -- it's an honest record of what's configured vs. not, same "never invent" discipline as
// everywhere else in this app.
model Integration {
  id             String    @id @default(cuid())
  type           String    @unique // ODOO | ANALYTIX360 | EMAIL | WHATSAPP | OTHER
  name           String
  status         String    @default("NOT_CONFIGURED") // NOT_CONFIGURED | CONFIGURED
  endpointOrNote String?
  configuredById String?
  configuredBy   User?     @relation(fields: [configuredById], references: [id])
  configuredAt   DateTime?
  updatedAt      DateTime  @updatedAt
}

