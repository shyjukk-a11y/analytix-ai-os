# Postgres connection string (Neon, Supabase, or any managed Postgres).
# DATABASE_URL = the connection the app uses (on Vercel/serverless, use the pooled host + &pgbouncer=true).
# DIRECT_URL   = the non-pooled connection `prisma migrate` uses. Locally both can be the same direct URL.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Generate a real secret for anything beyond local dev: `openssl rand -base64 32`
NEXTAUTH_SECRET="replace-me-with-a-random-secret"
# Local dev: http://localhost:3000 — Production: your real domain, e.g. https://app.analytix.org
NEXTAUTH_URL="http://localhost:3000"

# Set automatically by Vercel once Blob storage is enabled on the project (Project Settings ->
# Storage -> Blob -> Connect). When unset, the app falls back to local-disk storage under
# KNOWLEDGE_STORAGE_DIR, which only works for local dev (Vercel has no persistent filesystem).
BLOB_READ_WRITE_TOKEN=""

# Local-dev-only fallback storage location, used when BLOB_READ_WRITE_TOKEN is not set.
KNOWLEDGE_STORAGE_DIR="./storage/knowledge-sources"

# --- AI interviewer (OpenRouter) ---
# "on" routes the employee interview chat through an LLM (grounded in the project/department
# context); "off" or unset keeps the original deterministic rule-based engine. The AI path only
# runs when OPENROUTER_API_KEY is also set, so this is safe to leave "on" without a key.
LLM_MODE="off"
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=""
# Any model slug from https://openrouter.ai/models — a cheap, fast one is fine here.
OPENROUTER_MODEL="google/gemini-2.5-flash"
OPENROUTER_APP_URL="http://localhost:3000"
OPENROUTER_APP_NAME="Analytix AI OS"
