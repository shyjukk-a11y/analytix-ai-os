# Local dev DB (SQLite file). Swap to a Postgres URL for later phases / production,
# e.g. postgresql://user:password@localhost:5432/analytix_ai_os
DATABASE_URL="file:./dev.db"

# Generate a real secret for anything beyond local dev: `openssl rand -base64 32`
NEXTAUTH_SECRET="replace-me-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Local knowledge-source file storage (Phase 1). Swap for S3-compatible storage later.
KNOWLEDGE_STORAGE_DIR="./storage/knowledge-sources"
